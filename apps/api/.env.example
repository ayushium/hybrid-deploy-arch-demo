# Local development. On EC2 these are written to /etc/app.env by user-data.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=local
DB_NAME=campuswall
PORT=3000

# Identity: set locally, UNSET on EC2 so it falls back to IMDSv2.
INSTANCE_ID=i-local-1
AZ=local-a

STRESS_ENABLED=true
# BURN_MS is NOT read here. It is edge configuration: apps/web/wrangler.jsonc.
